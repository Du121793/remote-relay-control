sleep 8
inject_raw 3 5000 1 0 1650 400
sleep 5
r3_oc=$(get_ch_field 3 "fault_reason")
[ "$r3_oc" = "2" ] && result "OC-003" PASS "clean ch r=$r3_oc" || result "OC-003" FAIL "r=$r3_oc"

# OC-004: Slow trip via user threshold (unlearned)
